{
  "mcpServers": {
    "ynab": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "ynab-mcp"
      ],
      "env": {
        "YNAB_ACCESS_TOKEN": "${YNAB_ACCESS_TOKEN}",
        "YNAB_DEFAULT_BUDGET_ID": "${YNAB_DEFAULT_BUDGET_ID}"
      }
    }
  }
}
